{
  "name": "daeumhwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "pnpm db:migrate",
    "build": "next build",
    "start": "next start",
    "prestart": "pnpm db:migrate",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ai-stub": "tsx e2e/ai-stub/server.ts",
    "e2e:server": "rm -rf .data/e2e && PGLITE_DATA_DIR=.data/e2e AI_SPEECH_STYLE=off AI_PROVIDER=anthropic ANTHROPIC_API_KEY=e2e-stub ANTHROPIC_BASE_URL=http://127.0.0.1:3199 AUTH_RATE_LIMIT=off BETTER_AUTH_URL=http://localhost:3100 pnpm db:migrate && PGLITE_DATA_DIR=.data/e2e AI_SPEECH_STYLE=off AI_PROVIDER=anthropic ANTHROPIC_API_KEY=e2e-stub ANTHROPIC_BASE_URL=http://127.0.0.1:3199 AUTH_RATE_LIMIT=off BETTER_AUTH_URL=http://localhost:3100 next build && PGLITE_DATA_DIR=.data/e2e AI_SPEECH_STYLE=off AI_PROVIDER=anthropic ANTHROPIC_API_KEY=e2e-stub ANTHROPIC_BASE_URL=http://127.0.0.1:3199 AUTH_RATE_LIMIT=off BETTER_AUTH_URL=http://localhost:3100 next start -p 3100",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "eval:continuity": "tsx eval/run-continuity.ts",
    "eval:novel": "tsx eval/novel/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "0.5.10",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "comlink": "4.4.2",
    "cytoscape": "3.34.4",
    "date-fns": "4.4.0",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "es-hangul": "2.4.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "inngest": "4.24.0",
    "lucide-react": "^1.57.0",
    "mammoth": "1.13.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.8.1"
}
