# 다음화 환경변수 예시. 복사해서 .env.local로 쓴다. `pnpm db:migrate` 도 .env.local, .env 를 읽는다. 셸에 직접 지정한 값이 우선한다.

# Postgres 연결 주소. 없으면 로컬 PGlite 파일 DB를 쓴다. Vercel에서는 필수이며 Production·Preview 모두에 설정한다. (예: postgres://user:pass@localhost:5432/daeumhwa)
DATABASE_URL=

# PGlite 데이터 폴더. 기본값은 .data/pglite.
PGLITE_DATA_DIR=

# 로그인 세션 암호화 키. 32자 이상 무작위 문자열.
BETTER_AUTH_SECRET=

# 앱 공개 주소. 로컬은 http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# Anthropic API 키. 서버에서만 읽는다. ANTHROPIC_API_KEY와 OPENCODE_API_KEY가 모두 없으면 AI 기능을 쓸 수 없다.
ANTHROPIC_API_KEY=

# Anthropic 기본 AI 모델. 기본값은 claude-haiku-5-5.
ANTHROPIC_MODEL=

# Anthropic 원고 가져오기 전용 모델. 없으면 ANTHROPIC_MODEL을 쓴다.
ANTHROPIC_MODEL_IMPORT=

# OpenCode Go API 키. 서버에서만 읽는다. Anthropic 키가 없을 때 쓴다.
OPENCODE_API_KEY=

# OpenCode Go 기본 AI 모델. 기본값은 claude-haiku-5-5. Anthropic 형식과 OpenAI(Responses) 형식 모델을 모두 쓸 수 있다. 형식은 모델 이름으로 자동으로 정한다.
# Anthropic 형식: claude-haiku-5-5, qwen3.8-flash, qwen3.8-max, minimax-m3, qwen3.7-plus
# OpenAI 형식: gpt-6-luna, gpt-5.6-luna, grok-4.7, muse-spark-1.3-contributor, muse-spark-1.2-contributor
# 주의: *-contributor 모델(예: muse-spark-1.3-contributor)은 보낸 원고와 설정이 모델 학습에 쓰일 수 있다. 공개 전 원고에는 쓰지 말 것. 앱 화면에 경고가 뜬다.
OPENCODE_MODEL=

# OpenCode Go 원고 가져오기 전용 모델. 없으면 OPENCODE_MODEL을 쓴다. 기본 모델과 다른 형식을 써도 된다 (호출마다 형식을 고른다).
OPENCODE_MODEL_IMPORT=

# OpenCode Go Anthropic 형식 주소 재정의. 기본값은 https://opencode.ai/inference/go/anthropic.
OPENCODE_BASE_URL=

# OpenCode Go OpenAI(Responses) 형식 주소 재정의. 기본값은 https://opencode.ai/inference/go/openai/v1.
OPENCODE_OPENAI_BASE_URL=

# 모든 OpenCode 모델의 API 형식을 강제한다: anthropic | responses. 비우면 모델 이름으로 정한다. 다른 값은 무시한다.
OPENCODE_API_FORMAT=

# AI 공급자 선택: anthropic | opencode. 비우면 ANTHROPIC_API_KEY, 다음으로 OPENCODE_API_KEY 유무로 정한다. 그 밖의 값은 무시한다.
# E2E는 AI_PROVIDER=anthropic, ANTHROPIC_BASE_URL=http://127.0.0.1:3199 (e2e/ai-stub)로 뜬다. 직접 설정할 필요는 없다.
AI_PROVIDER=

# 프롬프트 캐시 유지 시간. 1h이면 Anthropic 캐시를 1시간으로 늘린다. 비우면 기본(5분)이다. 게이트웨이가 받아줄 때만 켠다.
# AI_CACHE_TTL=1h

# Responses 캐시 유지. 24h이면 prompt_cache_retention을 24시간으로 보낸다. 비우면 보내지 않는다. 게이트웨이가 받아줄 때만 켠다.
# AI_CACHE_RETENTION=24h

# 로그인·가입 요청 제한. 운영에서는 비워 둔다(IP당 10초에 3회). off를 주면 제한을 끈다. e2e 테스트 전용.
AUTH_RATE_LIMIT=

# 사용자당 하루 AI 토큰 한도. 기본값은 3000000 (300만).
AI_DAILY_TOKEN_LIMIT=

# 인물 말투 기능. 기본은 켜짐: 인터뷰가 주요 인물의 말투를 묻고 초안에 <voices> 블록을 넣는다. 끄려면 off를 준다.
# AI_SPEECH_STYLE=off

# Inngest 이벤트 키. 원고 가져오기 백그라운드 작업에 쓴다. 없으면 브라우저가 단계별로 진행한다.
INNGEST_EVENT_KEY=

# Inngest 서명 키. INNGEST_DEV를 쓰지 않으면(클라우드 모드) 필요하다.
INNGEST_SIGNING_KEY=

# Inngest 로컬 개발 모드. 1이면 로컬 Inngest 개발 서버를 쓴다. (1 이외의 값은 인식하지 않는다)
INNGEST_DEV=
