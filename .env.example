# 다음화 환경변수 예시. 복사해서 .env.local로 쓴다. `pnpm db:migrate` 도 .env.local, .env 를 읽는다. 셸에 직접 지정한 값이 우선한다.

# Postgres 연결 주소. 없으면 로컬 PGlite 파일 DB를 쓴다. Vercel에서는 필수이며 Production·Preview 모두에 설정한다. (예: postgres://user:pass@localhost:5432/daeumhwa)
DATABASE_URL=

# PGlite 데이터 폴더. 기본값은 .data/pglite.
PGLITE_DATA_DIR=

# 로그인 세션 암호화 키. 32자 이상 무작위 문자열.
BETTER_AUTH_SECRET=

# 앱 공개 주소. 로컬은 http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# Anthropic API 키. 서버에서만 읽는다. ANTHROPIC_API_KEY와 OPENCODE_API_KEY가 모두 없으면 데모 모드로 동작한다.
ANTHROPIC_API_KEY=

# Anthropic 기본 AI 모델. 기본값은 claude-haiku-5-5.
ANTHROPIC_MODEL=

# Anthropic 원고 가져오기 전용 모델. 없으면 ANTHROPIC_MODEL을 쓴다.
ANTHROPIC_MODEL_IMPORT=

# OpenCode Go API 키. 서버에서만 읽는다. Anthropic 키가 없을 때 쓴다.
OPENCODE_API_KEY=

# OpenCode Go 기본 AI 모델. 기본값은 claude-haiku-5-5. Anthropic 형식 모델만 쓴다 (예: claude-haiku-5-5, qwen3.8-flash, qwen3.8-max).
OPENCODE_MODEL=

# OpenCode Go 원고 가져오기 전용 모델. 없으면 OPENCODE_MODEL을 쓴다.
OPENCODE_MODEL_IMPORT=

# OpenCode Go 주소 재정의. 기본값은 https://opencode.ai/inference/go/anthropic.
OPENCODE_BASE_URL=

# AI 공급자 선택: anthropic | opencode | fake. 비우면 ANTHROPIC_API_KEY, 다음으로 OPENCODE_API_KEY 유무로 정한다. fake는 키가 있어도 가짜 응답을 쓴다.
AI_PROVIDER=

# 로그인·가입 요청 제한. 운영에서는 비워 둔다(IP당 10초에 3회). off를 주면 제한을 끈다. e2e 테스트 전용.
AUTH_RATE_LIMIT=

# 사용자당 하루 AI 토큰 한도. 기본값은 3000000 (300만).
AI_DAILY_TOKEN_LIMIT=

# Inngest 이벤트 키. 원고 가져오기 백그라운드 작업에 쓴다. 없으면 브라우저가 단계별로 진행한다.
INNGEST_EVENT_KEY=

# Inngest 서명 키. INNGEST_DEV를 쓰지 않으면(클라우드 모드) 필요하다.
INNGEST_SIGNING_KEY=

# Inngest 로컬 개발 모드. 1이면 로컬 Inngest 개발 서버를 쓴다. (1 이외의 값은 인식하지 않는다)
INNGEST_DEV=
